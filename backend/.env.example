# Database
DB_TARGET=local
LOCAL_DATABASE_URL="postgresql://user:password@localhost:5432/gdgoc_db?schema=public"
CLOUD_DATABASE_URL=""
# Cloud URL: session pooler port 5432; sslmode=verify-full&sslrootcert=URL_ENCODED_CA_PATH
# Legacy fallback when DB_TARGET is absent:
DATABASE_URL="postgresql://user:password@localhost:5432/gdgoc_db?schema=public"

# Auth
JWT_SECRET=""
SESSION_COOKIE_SAME_SITE=lax

# Server
PORT=8080

NODE_ENV=production
CORS_ORIGINS=https://your-frontend-domain.example
TRUST_PROXY_HOPS=0
GDGOC_FORM_WEBHOOK_SECRET_KEY=
ENABLE_LEGACY_ONBOARD_WEBHOOK=false
INITIAL_MEMBER_SECRET_PREFIX=

# Profile images (backend only; never use VITE_ for these values)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=profile-images

# Password reset mail: Gmail SMTP (enable 2-Step Verification, create an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-club-email@gmail.com
SMTP_PASS=
SMTP_FROM="GDG on Campus FPTU HCMC <your-club-email@gmail.com>"
APP_FRONTEND_URL=http://localhost:3000

# Web recruitment -> PostgreSQL -> background Apps Script mirror
# Secret must match Script Properties; deploy Code.gs protocol v2.
RECRUITMENT_OPEN=false
RECRUITMENT_CYCLE=Gen 4.0 - Fall 2026
RECRUITMENT_APPS_SCRIPT_URL=
RECRUITMENT_WEBHOOK_SECRET=
