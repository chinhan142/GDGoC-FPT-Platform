# Database
DATABASE_URL="postgresql://user:password@localhost:5432/gdgoc_db?schema=public"

# Auth
JWT_SECRET=""

# Server
PORT=8080

NODE_ENV=production
CORS_ORIGINS=https://your-frontend-domain.example
TRUST_PROXY_HOPS=0
GDGOC_FORM_WEBHOOK_SECRET_KEY=
INITIAL_MEMBER_SECRET_PREFIX=

# Profile images (backend only; never use VITE_ for these values)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=profile-images

# Password reset mail: Gmail SMTP (enable 2-Step Verification, create an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-club-email@gmail.com
SMTP_PASS=
SMTP_FROM="GDG on Campus FPTU HCMC <your-club-email@gmail.com>"
APP_FRONTEND_URL=http://localhost:3000
