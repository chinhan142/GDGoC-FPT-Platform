datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================


enum Role {
  ADVISOR
  LEAD
  DEPARTMENT_LEAD
  MEMBER
  ADMIN
}


enum DepartmentType {
  EXECUTIVE
  TECH_AI
  TECH_CLOUD
  TECH_WEB
  TECH_RESEARCH
  MEDIA
  HR_EVENT
}

enum MemberStatus {
  ACTIVE      // Đang hoạt động
  PROBATION   // Thành viên mới / Thử việc
  ON_LEAVE    // Tạm nghỉ
  ALUMNI      // Cựu thành viên
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  OVERDUE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskAssigneeRole {
  PRIMARY
  MEMBER
}


enum EventType {
  WORKSHOP        // Workshop Series, Codelab
  MEETING         // Họp nội bộ, Briefing
  HACKATHON       // Cuộc thi lập trình
  TEAMBUILDING    // Team bonding, nội bộ
  SHOWCASE        // Triển lãm sản phẩm (Showcase & Awarding Day)
  CAMPUS_CHALLENGE // Google Solution Challenge, Skills Boost Challenge
  FLAGSHIP        // Sự kiện flagship (Google I/O Extended)
}



enum DriveCategory {
  BRAND_KIT       // Bộ nhận diện thương hiệu, logo, guidelines
  TECH_LIBRARY    // Tài liệu kỹ thuật, notebooks, code samples
  MEDIA_VAULT     // Ảnh sự kiện, video recap, motion graphics
  PR_COMMS        // Tài liệu PR, press release, social media content
  FINANCE         // Hóa đơn, báo cáo tài chính, ngân sách
  HANDOVER_VAULT  // Tài liệu bàn giao nhiệm kỳ
}

enum AccessLevel {
  PUBLIC           // Công khai (landing page, không cần đăng nhập)
  INTERNAL_MEMBER  // Tất cả thành viên đã đăng nhập
  DEPARTMENT_ONLY  // Chỉ thành viên trong ban tương ứng
  EXECUTIVE_ONLY   // Chỉ BCN (LEAD role)
}

enum GemsTransactionType {
  TASK_REWARD       // Nhận gems khi hoàn thành task được duyệt
  EVENT_CONTRIBUTION
  MANUAL_ADJUSTMENT // BCN điều chỉnh thủ công (khen thưởng / phạt)
}



enum NotificationType {
  TASK      // Liên quan đến task mới / cập nhật task
  EVENT     // Thông báo sự kiện
  GEMS      // Thưởng/phạt gems
  BROADCAST // Thông báo toàn CLB từ BCN
  SYSTEM    // Thông báo hệ thống
}

enum NotificationPriority {
  NORMAL
  IMPORTANT
  URGENT
}

// ==========================================
// 1. USERS, HR & RBAC
// ==========================================


model User {
  id              String   @id @default(uuid())
  mssv            String   @unique
  email           String   @unique
  fullName        String
  phoneNumber     String?
  avatarUrl       String?
  coverUrl        String?
  githubUrl       String?
  facebookUrl     String?
  linkedinUrl     String?
  mustChangePassword Boolean @default(true)
  passwordHash    String
  gemsBalance     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenures             UserTenure[]
  createdTasks        Task[]             @relation("TaskCreator")
  assignedTasks       TaskAssignee[]
  eventContributions EventContribution[]
  receivedNotifications Notification[] @relation("NotificationRecipient")
  gemsTransactions    GemsTransaction[] @relation("GemsRecipient")
  adjustedGemsTransactions GemsTransaction[] @relation("GemsActor")
  sentNotifications   Notification[]     @relation("NotificationSender")

  @@map("users")
}


model Tenure {
  id          String   @id @default(uuid())
  name        String   // Ví dụ: "Fall 2026"
  genLabel    String   // Ví dụ: "Gen 4.0"
  startDate   DateTime
  endDate     DateTime
  isFrozen    Boolean  @default(false)
  isArchived  Boolean  @default(false)
  chapterLead String?  // Tên Chapter Lead kỳ này (snapshot)
  createdAt   DateTime @default(now())

  semesters   Semester[]
  userTenures UserTenure[]
  tasks       Task[]
  events      Event[]
  driveAssets DriveAsset[]

  @@map("tenures")
}


model Department {
  id               String         @id @default(uuid())
  code             DepartmentType @unique
  name             String         // Tên đầy đủ tiếng Việt
  nameEn           String         // Tên tiếng Anh

  userTenures     UserTenure[]
  tasks           Task[]
  driveAssets     DriveAsset[]
  notifications   Notification[]

  @@map("departments")
}


model UserTenure {
  id           String       @id @default(uuid())
  userId       String
  tenureId     String
  departmentId String
  role         Role         @default(MEMBER)
  status       MemberStatus @default(PROBATION)
  position     String?      // Chức danh hiển thị
  bio          String?
  skills       String[]     // Array các kỹ năng
  joinedAt     DateTime     @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenure     Tenure     @relation(fields: [tenureId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id])

  @@unique([userId, tenureId])
  @@map("user_tenures")
}

// ==========================================
// 2. TASK MANAGEMENT (KANBAN)
// ==========================================


model Task {
  id              String       @id @default(uuid())
  title           String
  description     String?
  status          TaskStatus   @default(TODO)
  priority        TaskPriority @default(MEDIUM)
  deadline        DateTime
  gemsReward      Int          @default(20)
  submissionUrl   String?      // Link nộp bài (Google Drive, GitHub PR, v.v.)
  feedback        String?      // Phản hồi của Lead sau review

  tenureId     String
  departmentId String
  creatorId    String
  eventId      String?

  tenure     Tenure         @relation(fields: [tenureId], references: [id])
  department Department     @relation(fields: [departmentId], references: [id])
  creator    User           @relation("TaskCreator", fields: [creatorId], references: [id])
  event      Event?         @relation(fields: [eventId], references: [id])
  assignees  TaskAssignee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tasks")
  semesterId String
  semester Semester @relation(fields: [semesterId], references: [id])
  completedAt DateTime?
}

model TaskAssignee {
  id     String           @id @default(uuid())
  taskId String
  userId String
  role   TaskAssigneeRole @default(MEMBER)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@map("task_assignees")
}

// ==========================================
// 3. EVENT & ATTENDANCE HUB
// ==========================================


model Event {
  id              String    @id @default(uuid())
  title           String
  description     String?
  type            EventType
  location        String
  startTime       DateTime
  endTime         DateTime
  status          String?   @default("Registration Open")
  contributionGems Int @default(20)
  driveFolderUrl  String?
  registrationUrl String?
  isPublic        Boolean   @default(false) // true → hiển thị landing page
  bannerImageUrl  String?
  tenureId        String

  tenure Tenure @relation(fields: [tenureId], references: [id])

  tasks       Task[]
  contributions EventContribution[]
  driveAssets DriveAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("events")
  semesterId String
  semester Semester @relation(fields: [semesterId], references: [id])
}


model EventContribution {
  id String @id @default(uuid())
  eventId String
  userId String
  roleInEvent String?
  notes String?
  isGemsGranted Boolean @default(false)
  createdAt DateTime @default(now())
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
  @@unique([eventId, userId])
  @@map("event_contributions")
}




// ==========================================
// 4. SMART GOOGLE DRIVE ASSET HUB
// ==========================================


model DriveAsset {
  id          String        @id @default(uuid())
  name        String
  description String?
  category    DriveCategory
  driveUrl    String
  driveFileId String
  accessLevel AccessLevel   @default(INTERNAL_MEMBER)
  uploadedById String?

  tenureId     String
  departmentId String?
  eventId      String?

  tenure     Tenure      @relation(fields: [tenureId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  event      Event?      @relation(fields: [eventId], references: [id])

  createdAt DateTime @default(now())

  @@map("drive_assets")
}

// ==========================================
// 5. INVENTORY MANAGEMENT
// ==========================================


model InventoryItem {
  id           String   @id @default(uuid())
  name         String
  category     String   // "Asset" | "Gift" | "Consumable"
  quantity     Int
  holderName   String   // Tên người giữ (có thể là "Lưu tại tủ đồ CLB")
  holderUserId String?  // Link tới User nếu có
  notes        String?
  assignedDate DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("inventory_items")
}

// ==========================================
// 6. NOTIFICATIONS
// ==========================================


model Notification {
  id                 String               @id @default(uuid())
  title              String
  message            String
  type               NotificationType
  priority           NotificationPriority @default(NORMAL)
  targetUserId String?
  targetUser User? @relation("NotificationRecipient", fields: [targetUserId], references: [id])
  targetDepartmentId String?              // null = broadcast cho toàn bộ
  link               String?              // Deep link vào portal
  senderId           String

  sender           User        @relation("NotificationSender", fields: [senderId], references: [id])
  targetDepartment Department? @relation(fields: [targetDepartmentId], references: [id])
  reads            NotificationRead[]

  createdAt DateTime @default(now())

  @@map("notifications")
}


model NotificationRead {
  id             String   @id @default(uuid())
  notificationId String
  userId         String
  readAt         DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@map("notification_reads")
}

// ==========================================
// 7. GAMIFICATION & GEMS
// ==========================================


model GemsTransaction {
  id             String              @id @default(uuid())
  userId         String
  actorId        String?
  amount         Int                 // Dương = cộng, Âm = trừ
  type           GemsTransactionType
  referenceId    String?             // ID của task/event liên quan
  reason         String              // Mô tả giao dịch
  idempotencyKey String              @unique

  user User @relation("GemsRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("GemsActor", fields: [actorId], references: [id], onDelete: Restrict)
  @@index([actorId])

  createdAt DateTime @default(now())

  @@map("gems_transactions")
  semesterId String?
  semester Semester? @relation(fields: [semesterId], references: [id])
}







// ==========================================
// 8. LANDING PAGE CMS CONFIGURATION
// ==========================================


model LandingConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  data      Json
  updatedAt DateTime @updatedAt

  @@map("landing_configs")
}

model Semester {
  id String @id @default(uuid())
  name String
  tenureId String
  startDate DateTime
  endDate DateTime
  isClosed Boolean @default(false)
  createdAt DateTime @default(now())
  tenure Tenure @relation(fields: [tenureId], references: [id])
  tasks Task[]
  events Event[]
  transactions GemsTransaction[]
  @@unique([tenureId, name])
  @@map("semesters")
}
