/**
 * GDGoC FPTU HCMC Portal — Prisma Database Schema
 * 
 * Phiên bản: v1.1 (cập nhật theo project FE hiện tại)
 * Cập nhật: Thêm ADVISOR role, đồng bộ với frontend types
 * 
 * Thay đổi so với schema gốc:
 * - Thêm ADVISOR vào enum Role (ngang cấp LEAD nhưng read-only)
 * - Thêm model Notification (thông báo nội bộ)
 * - Thêm model InventoryItem (quản lý vật tư CLB)
 * - Thêm isAdvisor flag trên UserTenure để phân biệt quyền hạn
 * - Thêm discordRoleId cho từng DepartmentType để sync Discord
 * - Cập nhật EventType bổ sung SHOWCASE, CAMPUS_CHALLENGE
 * - Thêm GiftItem / GiftRedemption vào Gems gamification
 */

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

/**
 * Role — Vai trò trong một nhiệm kỳ (UserTenure)
 * 
 * ADVISOR         : Cố vấn CLB. Ngang cấp với Ban Chủ Nhiệm nhưng chỉ có quyền
 *                   đọc (view-only). Không được thực hiện các thao tác ghi.
 * LEAD            : Ban Chủ Nhiệm (Chapter Lead, Co-Chapter Lead).
 *                   Quyền cao nhất — quản lý toàn bộ hệ thống.
 * DEPARTMENT_LEAD : Trưởng Ban (AI Lead, Cloud Lead, Web Lead, v.v.).
 *                   Quyền quản lý trong phạm vi ban của mình.
 * MEMBER          : Thành viên ban.
 * COLLABORATOR    : Cộng tác viên / Thành viên thử việc (probation).
 */
enum Role {
  ADVISOR
  LEAD
  DEPARTMENT_LEAD
  MEMBER
  COLLABORATOR
}

/**
 * DepartmentType — Mã định danh các ban trong CLB
 * 
 * EXECUTIVE   : Ban Chủ Nhiệm (Chapter Lead, Co-Chapter Lead)
 * TECH_AI     : Ban Trí Tuệ Nhân Tạo
 * TECH_CLOUD  : Ban Điện Toán Đám Mây
 * TECH_WEB    : Ban Phát Triển Web
 * TECH_RESEARCH: Ban Nghiên Cứu & Học Thuật
 * MEDIA       : Ban Truyền Thông & Thiết Kế
 * HR_EVENT    : Ban Nhân Sự & Tổ Chức Sự Kiện
 */
enum DepartmentType {
  EXECUTIVE
  TECH_AI
  TECH_CLOUD
  TECH_WEB
  TECH_RESEARCH
  MEDIA
  HR_EVENT
}

enum MemberStatus {
  ACTIVE      // Đang hoạt động
  PROBATION   // Thành viên mới / Thử việc
  ON_LEAVE    // Tạm nghỉ
  ALUMNI      // Cựu thành viên
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  OVERDUE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskAssigneeRole {
  PRIMARY
  MEMBER
}

/**
 * EventType — Phân loại sự kiện
 * 
 * Bổ sung thêm SHOWCASE và CAMPUS_CHALLENGE so với schema gốc
 * để đồng bộ với frontend EventItem.category
 */
enum EventType {
  WORKSHOP        // Workshop Series, Codelab
  MEETING         // Họp nội bộ, Briefing
  HACKATHON       // Cuộc thi lập trình
  TEAMBUILDING    // Team bonding, nội bộ
  SHOWCASE        // Triển lãm sản phẩm (Showcase & Awarding Day)
  CAMPUS_CHALLENGE // Google Solution Challenge, Skills Boost Challenge
  FLAGSHIP        // Sự kiện flagship (Google I/O Extended)
}

enum CheckinMethod {
  QR_DYNAMIC       // QR code động (mỗi lần mới)
  DISCORD_COMMAND  // Check-in qua Discord bot command
  MANUAL_EVIDENCE  // Ban HR-Event điểm danh tay + upload evidence
}

enum DriveCategory {
  BRAND_KIT       // Bộ nhận diện thương hiệu, logo, guidelines
  TECH_LIBRARY    // Tài liệu kỹ thuật, notebooks, code samples
  MEDIA_VAULT     // Ảnh sự kiện, video recap, motion graphics
  PR_COMMS        // Tài liệu PR, press release, social media content
  FINANCE         // Hóa đơn, báo cáo tài chính, ngân sách
  HANDOVER_VAULT  // Tài liệu bàn giao nhiệm kỳ
}

enum AccessLevel {
  PUBLIC           // Công khai (landing page, không cần đăng nhập)
  INTERNAL_MEMBER  // Tất cả thành viên đã đăng nhập
  DEPARTMENT_ONLY  // Chỉ thành viên trong ban tương ứng
  EXECUTIVE_ONLY   // Chỉ BCN (LEAD role)
}

enum GemsTransactionType {
  TASK_REWARD       // Nhận gems khi hoàn thành task được duyệt
  EVENT_ATTENDANCE  // Nhận gems khi điểm danh sự kiện
  EVENT_ORGANIZER   // Nhận gems khi đóng vai trò tổ chức sự kiện
  GIFT_REDEMPTION   // Tiêu gems đổi quà tặng
  MANUAL_ADJUSTMENT // BCN điều chỉnh thủ công (khen thưởng / phạt)
}

enum RedemptionStatus {
  PENDING   // Chờ BCN duyệt
  APPROVED  // Đã duyệt, chờ giao quà
  DELIVERED // Đã giao quà thành công
  REJECTED  // Bị từ chối
}

enum NotificationType {
  TASK      // Liên quan đến task mới / cập nhật task
  EVENT     // Thông báo sự kiện
  GEMS      // Thưởng/phạt gems
  BROADCAST // Thông báo toàn CLB từ BCN
  SYSTEM    // Thông báo hệ thống
}

enum NotificationPriority {
  NORMAL
  IMPORTANT
  URGENT
}

// ==========================================
// 1. USERS, HR & RBAC
// ==========================================

/**
 * User — Thành viên CLB
 * 
 * Một user có thể có nhiều UserTenure (mỗi nhiệm kỳ một record).
 * Mật khẩu hash bằng bcrypt, không store plaintext.
 * Discord integration để sync thông báo và check-in.
 */
model User {
  id              String   @id @default(uuid())
  mssv            String   @unique
  email           String   @unique
  fullName        String
  phoneNumber     String?
  avatarUrl       String?
  githubUrl       String?
  facebookUrl     String?
  linkedinUrl     String?
  discordId       String?  @unique
  discordUsername String?
  passwordHash    String
  gemsBalance     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenures             UserTenure[]
  createdTasks        Task[]             @relation("TaskCreator")
  assignedTasks       TaskAssignee[]
  eventAttendances    EventAttendance[]
  eventOrganizers     EventOrganizer[]
  gemsTransactions    GemsTransaction[]
  giftRedemptions     GiftRedemption[]   @relation("RedemptionRequester")
  approvedRedemptions GiftRedemption[]   @relation("RedemptionApprover")
  sentNotifications   Notification[]     @relation("NotificationSender")

  @@map("users")
}

/**
 * Tenure — Nhiệm kỳ hoạt động
 * 
 * Ví dụ: "Fall 2026 - Gen 4.0" là một Tenure.
 * Mọi entity liên quan đến một kỳ (tasks, events, assets) đều tham chiếu TenureId.
 * 
 * isFrozen  : Khóa không cho submit task / check-in mới
 * isArchived: Ẩn khỏi view active, chuyển sang lịch sử
 */
model Tenure {
  id          String   @id @default(uuid())
  name        String   // Ví dụ: "Fall 2026"
  genLabel    String   // Ví dụ: "Gen 4.0"
  startDate   DateTime
  endDate     DateTime
  isFrozen    Boolean  @default(false)
  isArchived  Boolean  @default(false)
  chapterLead String?  // Tên Chapter Lead kỳ này (snapshot)
  createdAt   DateTime @default(now())

  userTenures UserTenure[]
  tasks       Task[]
  events      Event[]
  driveAssets DriveAsset[]

  @@map("tenures")
}

/**
 * Department — Ban trong CLB
 * 
 * discordRoleId    : Role ID trên Discord server để sync permission
 * discordChannelId : Channel ID chính của ban trên Discord
 */
model Department {
  id               String         @id @default(uuid())
  code             DepartmentType @unique
  name             String         // Tên đầy đủ tiếng Việt
  nameEn           String         // Tên tiếng Anh
  discordRoleId    String?
  discordChannelId String?

  userTenures     UserTenure[]
  tasks           Task[]
  eventOrganizers EventOrganizer[]
  driveAssets     DriveAsset[]
  notifications   Notification[]

  @@map("departments")
}

/**
 * UserTenure — Membership record cho một thành viên trong một nhiệm kỳ
 * 
 * Đây là bảng pivot chính xác định quyền hạn của user trong hệ thống.
 * 
 * role = ADVISOR    → Cố vấn, view-only toàn bộ
 * role = LEAD       → Ban Chủ Nhiệm, full access
 * role = DEPARTMENT_LEAD → Trưởng ban, có thể quản lý ban của mình
 * role = MEMBER     → Thành viên thường
 * role = COLLABORATOR → CTV / thành viên thử việc
 * 
 * position: Chức danh display (ví dụ: "Chapter Lead", "AI Lead", "Cloud Member")
 */
model UserTenure {
  id           String       @id @default(uuid())
  userId       String
  tenureId     String
  departmentId String
  role         Role         @default(MEMBER)
  status       MemberStatus @default(PROBATION)
  position     String?      // Chức danh hiển thị
  bio          String?
  skills       String[]     // Array các kỹ năng
  joinedAt     DateTime     @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenure     Tenure     @relation(fields: [tenureId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id])

  @@unique([userId, tenureId])
  @@map("user_tenures")
}

// ==========================================
// 2. TASK MANAGEMENT (KANBAN)
// ==========================================

/**
 * Task — Nhiệm vụ trong Kanban Board
 * 
 * Mỗi task thuộc một ban (departmentId) và một nhiệm kỳ (tenureId).
 * Có thể gắn với một sự kiện (eventId) để liên kết task prep với event.
 * gemsReward: Số gems thưởng khi task được duyệt (status → DONE).
 */
model Task {
  id              String       @id @default(uuid())
  title           String
  description     String?
  status          TaskStatus   @default(TODO)
  priority        TaskPriority @default(MEDIUM)
  deadline        DateTime
  gemsReward      Int          @default(20)
  submissionUrl   String?      // Link nộp bài (Google Drive, GitHub PR, v.v.)
  feedback        String?      // Phản hồi của Lead sau review
  discordThreadId String?      // Thread Discord tương ứng

  tenureId     String
  departmentId String
  creatorId    String
  eventId      String?

  tenure     Tenure         @relation(fields: [tenureId], references: [id])
  department Department     @relation(fields: [departmentId], references: [id])
  creator    User           @relation("TaskCreator", fields: [creatorId], references: [id])
  event      Event?         @relation(fields: [eventId], references: [id])
  assignees  TaskAssignee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tasks")
}

model TaskAssignee {
  id     String           @id @default(uuid())
  taskId String
  userId String
  role   TaskAssigneeRole @default(MEMBER)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@map("task_assignees")
}

// ==========================================
// 3. EVENT & ATTENDANCE HUB
// ==========================================

/**
 * Event — Sự kiện CLB
 * 
 * Bao gồm tất cả loại sự kiện: workshop, meeting nội bộ, hackathon, showcase...
 * 
 * attendeeGems  : Gems thưởng cho người tham dự khi check-in thành công
 * organizerGems : Gems thưởng cho thành viên ban tổ chức (HR-Event)
 * isPublic      : Hiển thị ra landing page hay không
 * registrationUrl: Link đăng ký (Google Form hoặc portal)
 */
model Event {
  id              String    @id @default(uuid())
  title           String
  description     String?
  type            EventType
  location        String
  startTime       DateTime
  endTime         DateTime
  attendeeGems    Int       @default(20)
  organizerGems   Int       @default(100)
  driveFolderUrl  String?
  registrationUrl String?
  isPublic        Boolean   @default(false) // true → hiển thị landing page
  bannerImageUrl  String?
  tenureId        String

  tenure Tenure @relation(fields: [tenureId], references: [id])

  tasks       Task[]
  attendances EventAttendance[]
  organizers  EventOrganizer[]
  driveAssets DriveAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("events")
}

/**
 * EventAttendance — Bản ghi điểm danh sự kiện
 * 
 * Chỉ HR-Event (DEPARTMENT_LEAD/MEMBER trong HR_EVENT) và LEAD mới có thể
 * tạo/sửa/xóa bản ghi điểm danh.
 * 
 * checkinMethod: Phương thức check-in (QR, Discord, manual)
 * isVerified   : BCN/HR-Lead xác nhận điểm danh hợp lệ
 */
model EventAttendance {
  id               String        @id @default(uuid())
  eventId          String
  userId           String
  checkinTime      DateTime      @default(now())
  checkinMethod    CheckinMethod @default(MANUAL_EVIDENCE)
  evidenceImageUrl String?       // Ảnh chứng minh có mặt (nếu manual)
  isVerified       Boolean       @default(false)
  verifiedById     String?       // ID của người xác nhận (LEAD hoặc HR_EVENT lead)
  notes            String?       // Ghi chú của người điểm danh

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_attendances")
}

/**
 * EventOrganizer — Danh sách thành viên ban tổ chức cho một sự kiện
 * 
 * Dùng để cấp gems bonus cho ban tổ chức sau khi sự kiện kết thúc.
 */
model EventOrganizer {
  id            String  @id @default(uuid())
  eventId       String
  userId        String
  departmentId  String
  roleInEvent   String  // Ví dụ: "Trưởng BTC", "Check-in Staff", "MC"
  isGemsGranted Boolean @default(false) // Đã cấp gems chưa

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id])

  @@unique([eventId, userId])
  @@map("event_organizers")
}

// ==========================================
// 4. SMART GOOGLE DRIVE ASSET HUB
// ==========================================

/**
 * DriveAsset — Quản lý tài nguyên Google Drive nội bộ
 * 
 * driveFileId : ID file/folder trên Google Drive (để embed preview hoặc link)
 * accessLevel : Phân quyền xem tài nguyên
 */
model DriveAsset {
  id          String        @id @default(uuid())
  name        String
  description String?
  category    DriveCategory
  driveUrl    String
  driveFileId String
  accessLevel AccessLevel   @default(INTERNAL_MEMBER)
  uploadedById String?

  tenureId     String
  departmentId String?
  eventId      String?

  tenure     Tenure      @relation(fields: [tenureId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  event      Event?      @relation(fields: [eventId], references: [id])

  createdAt DateTime @default(now())

  @@map("drive_assets")
}

// ==========================================
// 5. INVENTORY MANAGEMENT
// ==========================================

/**
 * InventoryItem — Quản lý vật tư & tài sản CLB
 * 
 * Bao gồm: Tài sản (Standee, Mic), Quà tặng (Áo, Bình nước), Vật tư tiêu hao (Sticker)
 * holderUserId: User đang giữ item (null = lưu tại kho CLB)
 */
model InventoryItem {
  id           String   @id @default(uuid())
  name         String
  category     String   // "Asset" | "Gift" | "Consumable"
  quantity     Int
  holderName   String   // Tên người giữ (có thể là "Lưu tại tủ đồ CLB")
  holderUserId String?  // Link tới User nếu có
  notes        String?
  assignedDate DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("inventory_items")
}

// ==========================================
// 6. NOTIFICATIONS
// ==========================================

/**
 * Notification — Thông báo nội bộ CLB
 * 
 * targetDepartmentId = null  → Thông báo toàn CLB (broadcast)
 * targetDepartmentId = <id>  → Thông báo riêng cho 1 ban
 * 
 * ADVISOR, LEAD mới được tạo thông báo broadcast.
 * DEPARTMENT_LEAD có thể tạo thông báo cho ban của mình.
 */
model Notification {
  id                 String               @id @default(uuid())
  title              String
  message            String
  type               NotificationType
  priority           NotificationPriority @default(NORMAL)
  targetDepartmentId String?              // null = broadcast cho toàn bộ
  link               String?              // Deep link vào portal
  senderId           String

  sender           User        @relation("NotificationSender", fields: [senderId], references: [id])
  targetDepartment Department? @relation(fields: [targetDepartmentId], references: [id])
  reads            NotificationRead[]

  createdAt DateTime @default(now())

  @@map("notifications")
}

/**
 * NotificationRead — Trạng thái đã đọc của từng user
 */
model NotificationRead {
  id             String   @id @default(uuid())
  notificationId String
  userId         String
  readAt         DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@map("notification_reads")
}

// ==========================================
// 7. GAMIFICATION & GEMS
// ==========================================

/**
 * GemsTransaction — Lịch sử giao dịch gems
 * 
 * idempotencyKey: Đảm bảo không cộng gems 2 lần cho cùng 1 sự kiện.
 * Ví dụ: key = "task_reward_{taskId}" hoặc "event_attendance_{eventId}_{userId}"
 */
model GemsTransaction {
  id             String              @id @default(uuid())
  userId         String
  amount         Int                 // Dương = cộng, Âm = trừ
  type           GemsTransactionType
  referenceId    String?             // ID của task/event liên quan
  reason         String              // Mô tả giao dịch
  idempotencyKey String              @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("gems_transactions")
}

/**
 * GiftItem — Danh mục quà tặng có thể đổi bằng gems
 */
model GiftItem {
  id          String  @id @default(uuid())
  name        String
  description String?
  imageUrl    String?
  gemsPrice   Int
  stock       Int     @default(0)
  isActive    Boolean @default(true)

  redemptions GiftRedemption[]

  createdAt DateTime @default(now())

  @@map("gift_items")
}

/**
 * GiftRedemption — Yêu cầu đổi quà
 */
model GiftRedemption {
  id           String           @id @default(uuid())
  userId       String
  giftItemId   String
  approvedById String?
  gemsSpent    Int
  status       RedemptionStatus @default(PENDING)
  notes        String?

  user       User     @relation("RedemptionRequester", fields: [userId], references: [id])
  giftItem   GiftItem @relation(fields: [giftItemId], references: [id])
  approvedBy User?    @relation("RedemptionApprover", fields: [approvedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gift_redemptions")
}
